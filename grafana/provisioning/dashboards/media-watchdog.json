{
 "uid": "media-watchdog",
 "title": "Media library watchdog",
 "tags": [
  "mediastack",
  "media",
  "pinepods"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Media problems",
   "description": "Distinct findings on the last run. Zero means disk and database agree on every podcast, every episode has a duration, and no tree has root-owned files.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mediastack_media_watchdog_problems or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Last run completed",
   "description": "Whether the checks finished. If this is red the numbers beside it are from an incomplete run and are stale rather than reassuring.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mediastack_media_watchdog_success or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Since last run",
   "description": "Age of the newest run. The timer fires every 6 hours; past 14 hours it has wedged and silence stops meaning anything.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - mediastack_media_watchdog_last_run_timestamp_seconds",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 50400
       }
      ]
     },
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Check duration",
   "description": "How long the last pass took. It reads the tags of every episode in the library, so this climbs with the library and with a spun-down array.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mediastack_media_watchdog_duration_seconds",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 120
       }
      ]
     },
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Podcasts not imported",
   "description": "Folders with audio on disk and no PinePods entry. This is what a failed import looks like from outside: files present, nothing playable.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(mediastack_media_podcast_imported == 0 and mediastack_media_podcast_files_on_disk > 0) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Episodes missing duration",
   "description": "PinePods does not read duration from MP4-container files, so .m4a and .m4b shows import at zero and every progress bar is wrong.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(mediastack_media_podcast_zero_duration_episodes) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Title drift",
   "description": "Stored titles that no longer match the file's tag. An import only inserts new episodes, so retagging never fixes these on its own.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(mediastack_media_podcast_title_drift_episodes) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Import landmines (COMM)",
   "description": "Files carrying an ID3 COMM frame. Already-imported episodes are fine, but one such frame fails the NEXT import of that folder entirely.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(mediastack_media_podcast_comm_frames) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "table",
   "title": "Per podcast",
   "description": "Disk versus database, side by side. files_on_disk and episodes_in_db disagreeing is the fastest way to spot a partial import.",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mediastack_media_podcast_files_on_disk",
     "legendFormat": "{{podcast}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "mediastack_media_podcast_episodes_in_db",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "mediastack_media_podcast_zero_duration_episodes",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "mediastack_media_podcast_missing_artwork_episodes",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "E",
     "expr": "mediastack_media_podcast_orphan_episodes",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "F",
     "expr": "mediastack_media_podcast_title_drift_episodes",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "G",
     "expr": "mediastack_media_podcast_comm_frames",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "podcast",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "Time 4": true,
       "Time 5": true,
       "Time 6": true,
       "Time 7": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "job 1": true,
       "job 2": true,
       "job 3": true,
       "job 4": true,
       "job 5": true,
       "job 6": true,
       "job 7": true,
       "instance 1": true,
       "instance 2": true,
       "instance 3": true,
       "instance 4": true,
       "instance 5": true,
       "instance 6": true,
       "instance 7": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Root-owned media files",
   "description": "Anything running as uid 0 writing into a media tree. Audiobookshelf left 1204 such entries under Audiobooks that had to be chowned by hand.",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 0,
    "y": 17
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(mediastack_media_root_owned_files) or vector(0)",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Findings over time",
   "description": "Whether problems are being fixed or accumulating. A step up that never comes back down is something being tolerated.",
   "gridPos": {
    "h": 5,
    "w": 16,
    "x": 8,
    "y": 17
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mediastack_media_watchdog_problems",
     "legendFormat": "problems",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Datasource",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1
   }
  ]
 }
}
