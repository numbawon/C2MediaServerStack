{
  "uid": "ids-overview",
  "title": "Intrusion detection (Suricata + CrowdSec)",
  "tags": [
    "mediastack",
    "security",
    "ids"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Is the IDS actually working?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Rules loaded",
      "description": "The number that matters most. Suricata will run, log flows and pass every health check with ZERO rules loaded, detecting nothing -- which is exactly what happened during setup when suricata-update wrote rules into a directory the engine could not read. Red here means blind.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "suricata_rules_loaded",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Suricata",
      "description": "1 when stats are fresh. The process can be resident but wedged, which this catches and a container liveness check does not.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 5,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "suricata_up",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "CrowdSec",
      "description": "Up means logs are being parsed and bans issued. When it is down the Traefik bouncer keeps serving a stale decision list, so the site stays up but stops learning.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 9,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"crowdsec\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Packets/sec",
      "description": "Flat zero on a live network means Suricata is not seeing the wire at all: wrong interface, link down, or no promiscuous mode.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 13,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(suricata_kernel_packets_total[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Packet loss",
      "description": "Traffic arriving faster than it can be inspected. Anything sustained above a few percent means detection has real gaps.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(suricata_kernel_drops_total[5m]) / clamp_min(rate(suricata_kernel_packets_total[5m]), 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Detections",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Suricata alerts",
      "description": "Signature matches on the wire. Covers the LAN and the ports exposed there; near-blind to internet traffic, which arrives encrypted inside the Cloudflare tunnel.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(suricata_alerts_total[15m]) * 900",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "alerts / 15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CrowdSec scenarios triggered",
      "description": "Which detection scenarios are firing, by name. This is the HTTP-layer half: brute force, path probing, crawlers -- the attacks Suricata cannot see.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cs_bucket_poured_total[15m]) * 900",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "What CrowdSec is reading and deciding",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log lines ingested",
      "description": "Per source. A flat line for traefik means access logging broke; flat for suricata means the sensor stopped.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cs_filesource_hits_total[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{acquis_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Whitelisted events",
      "description": "Events matched but deliberately not acted on, by reason. Healthy: this is the safety net stopping a LAN device or the tunnel itself from being banned.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cs_node_wl_hits_ok_total[15m]) * 900",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Enforcement",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Bouncer pulls",
      "description": "The Traefik bouncer fetching the decision list. If this stops, bans stop being enforced even though CrowdSec keeps issuing them.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cs_lapi_bouncer_requests_total{route=\"/v1/decisions/stream\"}[15m])) * 900",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "pulls / 15m",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Active alerts",
      "description": "Distinct alert reasons CrowdSec currently holds.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 6,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(cs_alerts) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Rules failed to load",
      "description": "Signatures rejected at load time. Coverage is lower than the rule count implies.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 11,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "suricata_rules_failed",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Suricata uptime",
      "description": "Time since the engine last restarted.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "suricata_uptime_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  }
}