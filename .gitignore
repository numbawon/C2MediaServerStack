# Real config -- only .env.example is committed
.env

# Real domain/tunnel-ID-bearing config -- only the .example templates are
# committed. Copy the .example alongside each of these once and fill in
# your own values (see README's Setup order).
cloudflared/config.yml
cloudflared/emergency-config.yml
homer/config.yml

# Local file-based secrets for the standalone compose stacks
secrets/

# Runtime state migrated out of Docker named volumes so it is editable on
# the host. Not declarative config: these are live databases, caches and
# API keys the apps rewrite constantly. Deliberately NOT under /mnt/Media,
# which the `files` service serves read-write. Covered by both backup
# scripts.
.appdata/

# Backup output, restic cache
backups/
.restic-cache/

# Editor/OS cruft
.DS_Store
# Timestamped backups left beside a file when it is edited in place.
*.bak

# Generated by scripts/gen-prometheus-targets.sh -- holds the real domain
# and LAN IP. Prometheus does no env substitution, so these cannot be
# templated inline. Regenerate rather than commit.
prometheus/targets/*.json

# Python bytecode
__pycache__/
*.pyc

# Local GitHub Copilot instructions, agents, and repository-scoped state
.github/copilot-instructions.md
.github/instructions/
.github/agents/
.copilot/
