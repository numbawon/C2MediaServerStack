# Real config -- only .env.example is committed
.env

# Real domain/tunnel-ID-bearing config -- only the .example templates are
# committed. Copy the .example alongside each of these once and fill in
# your own values (see README's Setup order).
cloudflared/config.yml
cloudflared/emergency-config.yml
homer/config.yml

# Local file-based secrets for the standalone compose stacks
secrets/

# Backup output, restic cache
backups/
.restic-cache/

# Editor/OS cruft
.DS_Store

# Generated by scripts/gen-prometheus-targets.sh -- holds the real domain
# and LAN IP. Prometheus does no env substitution, so these cannot be
# templated inline. Regenerate rather than commit.
prometheus/targets/*.json
