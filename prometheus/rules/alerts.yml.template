# Alert rules. Kept deliberately small: a noisy alerting system gets
# muted, and a muted alerting system is worse than none because you
# believe you have one. Add rules when something actually breaks and you
# wish you'd been told, not preemptively.
#
# severity drives ntfy priority in alert-relay/relay.py:
#   critical -> priority 5 (bypasses Do Not Disturb, allowed to wake you)
#   warning  -> priority 4
#   info     -> priority 3

groups:
  - name: meta
    rules:
      # Always firing, on purpose. Alertmanager routes this to a
      # dead-end receiver, so it never notifies -- its only job is to be
      # visible in Alertmanager's UI. If you ever look and DON'T see
      # Watchdog firing, then Prometheus, its rule evaluation, or its
      # Alertmanager connection is broken, which is exactly the failure
      # that would otherwise make a broken stack look healthy.
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: "Alerting pipeline is alive"
          description: >-
            This alert always fires. Its absence is the signal.

      - alert: PrometheusNotConnectedToAlertmanager
        expr: prometheus_notifications_alertmanagers_discovered < 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Prometheus cannot reach Alertmanager"
          description: >-
            Rules are still evaluating but nothing can be delivered.
            Every other alert in this file is currently silent.

  - name: availability
    rules:
      - alert: TargetDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.job }} has been unreachable for 5 minutes"
          description: >-
            Prometheus cannot scrape {{ $labels.instance }}
            (job {{ $labels.job }}).

      - alert: ContainerRestartLoop
        # cadvisor resets container_start_time_seconds on every start, so
        # a rising count of distinct start times means the thing keeps
        # coming back. Three restarts in 15m is a loop, not a deploy.
        expr: changes(container_start_time_seconds{name!=""}[15m]) > 3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.name }} is restarting repeatedly"
          description: >-
            {{ $labels.name }} restarted more than 3 times in 15 minutes.
            Check `docker service logs` or `docker logs` for it.

      - alert: SwarmServiceNoContainers
        # A service that had a container half an hour ago and has none now.
        # Found 2026-10-21: redis, immich-redis and pinepods-valkey sat in
        # `Preparing` for three days after a registry pull failed during a
        # network blip. Swarm does not retry that, so nothing restarted and
        # nothing alerted. cadvisor labels every task container with its
        # service name, so the series vanishes the moment the last one goes.
        # The 30m offset plus `for: 15m` rides out a normal redeploy and the
        # 03:30 worker reboots. A service never seen running is not covered,
        # and one deliberately scaled to 0 will fire (scale it back or
        # remove it from the stack).
        expr: >-
          (count by (container_label_com_docker_swarm_service_name)
            (container_last_seen{container_label_com_docker_swarm_service_name!=""} offset 30m))
          unless
          (count by (container_label_com_docker_swarm_service_name)
            (container_last_seen{container_label_com_docker_swarm_service_name!=""}))
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.container_label_com_docker_swarm_service_name }} has no running container"
          description: >-
            Swarm service {{ $labels.container_label_com_docker_swarm_service_name }}
            had a container 30 minutes ago and now has none. Check
            `docker service ps --no-trunc <service>` for a stuck pull
            (`Preparing`) or a failed task, and `docker service update
            --force <service>` to retry.

  - name: host
    rules:
      # Disk thresholds are absolute, not percentages: required write
      # headroom depends on workload rather than filesystem size. Values
      # and media mountpoint are rendered from .env.

      # Filling the system disk stops Docker, databases, and config writes.
      - alert: SystemDiskFilling
        expr: node_filesystem_avail_bytes{mountpoint="/"} < ${PROM_SYSTEM_WARN_FREE_BYTES}
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "System disk below configured warning threshold"
          description: >-
            Docker images, container logs, and the Postgres data
            directory all live on the root filesystem.

      - alert: SystemDiskCritical
        expr: node_filesystem_avail_bytes{mountpoint="/"} < ${PROM_SYSTEM_CRIT_FREE_BYTES}
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "System disk below configured critical threshold"
          description: >-
            Postgres and Docker will start failing writes shortly.

      # Media, downloads, and completed should share one filesystem so
      # imports can hardlink. Watch that filesystem's available bytes.
      - alert: MediaStorageFilling
        expr: node_filesystem_avail_bytes{mountpoint="${COMMON_MEDIA}"} < ${PROM_MEDIA_WARN_FREE_BYTES}
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Media storage below configured warning threshold"
          description: >-
            ${COMMON_MEDIA} is filling up. The *arr apps will keep grabbing
            until it is full and then start failing imports. Check the
            import queues too, not just disk usage.

      - alert: MediaStorageCritical
        expr: node_filesystem_avail_bytes{mountpoint="${COMMON_MEDIA}"} < ${PROM_MEDIA_CRIT_FREE_BYTES}
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Media storage below configured critical threshold"
          description: >-
            ${COMMON_MEDIA} has no room for another large release. Imports
            will fail and partially-moved files can be left behind.

      # increase() rather than > 0 because these counters never reset
      # short of `btrfs device stats -z`, so a bare threshold would latch
      # on forever after a single historical blip.
      - alert: BtrfsDeviceErrors
        expr: increase(node_btrfs_device_errors_total[1h]) > 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "btrfs {{ $labels.type }} errors on {{ $labels.device }}"
          description: >-
            The array logged new {{ $labels.type }} errors on
            {{ $labels.device }}. Run
            `btrfs device stats ${COMMON_MEDIA}` and check SMART.

      - alert: HostMemoryPressure
        expr: >-
          node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.10
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Less than 10 percent memory available"
          description: >-
            Sustained memory pressure. The kernel OOM killer picks its
            own victim, and it is rarely the process you would have
            chosen.

  - name: backups
    rules:
      # These come from scripts/verify-backups.sh via node-exporter's
      # textfile collector. A weekly systemd job is invisible to
      # Prometheus otherwise, and "the backup job stopped running" looks
      # exactly like "nothing is wrong" without an explicit staleness
      # check.
      - alert: BackupVerificationStale
        # Runs weekly. 9 days allows one missed run plus slack before
        # complaining.
        expr: >-
          time() - mediastack_backup_verify_last_run_timestamp_seconds > 777600
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Backup verification has not run in over 9 days"
          description: >-
            The weekly restic check is not happening. Nothing is
            currently confirming the off-site backup is restorable.

      - alert: BackupIntegrityFailed
        expr: mediastack_backup_verify_integrity_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "restic check failed on the off-site repository"
          description: >-
            The B2 repository did not pass structural and sampled-data
            verification. Investigate before the next forget/prune, which
            could compact damage into the only remaining copy.

      - alert: BackupDatabaseRestoreFailed
        # The file restore test proves a directory tree comes back. This
        # proves a DATABASE does, which fails differently: a dump can be
        # present, correctly sized and valid gzip while being unloadable,
        # and the only way to know is to load it. Authentik's by default,
        # because losing that one locks you out of everything behind SSO.
        expr: mediastack_backup_verify_db_restore_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Database restore test failed"
          description: >-
            A dump was loaded into a throwaway Postgres and produced
            {{ $value }} tables against the count the dump itself declares.
            The dump exists but has not been shown to come back.

      - alert: BackupRestoreTestFailed
        expr: mediastack_backup_verify_restore_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Backup restore test failed"
          description: >-
            Restored {{ $value }} files against the count the snapshot
            manifest lists. The backup exists but has not been shown to
            come back.

      - alert: BackupRestoreTestStale
        # The restore test runs on a 28-day cycle; 45 days means two
        # cycles were missed or it has been failing silently.
        expr: >-
          time() - mediastack_backup_verify_restore_last_success_timestamp_seconds > 3888000
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "No successful restore test in over 45 days"
          description: >-
            Integrity checks may still be passing, but nothing has
            proven the data actually restores recently.

      # The gap that let a broken backup look healthy for days. The
      # verification alerts above check that STORED snapshots restore,
      # which kept passing while the nightly upload was failing on B2's
      # storage cap. These watch whether the JOB itself succeeded.
      - alert: BackupJobFailed
        expr: mediastack_backup_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "The off-site backup job failed on its last run"
          description: >-
            restic exited non-zero. Common causes: B2 storage or
            transaction cap exceeded, credentials expired, or a stale
            repository lock. Check
            `journalctl -u mediastack-backup-offsite.service`.

      - alert: BackupJobStale
        # Runs daily at 03:30. 30h allows one missed run plus slack.
        expr: >-
          time() - mediastack_backup_last_success_timestamp_seconds > 108000
        for: 1h
        labels:
          severity: critical
        annotations:
          summary: "No successful off-site backup in over 30 hours"
          description: >-
            Either the timer stopped or every run has been failing. This
            fires even if the job never runs at all, which a
            failure-only alert would miss.

      - alert: BackupSnapshotsMissing
        # forget --keep-daily 14 --keep-weekly 8 --keep-monthly 12 should
        # never leave fewer than a handful once the repo is established.
        expr: mediastack_backup_verify_snapshots < 2
        for: 1h
        labels:
          severity: critical
        annotations:
          summary: "Off-site repository has fewer than 2 snapshots"
          description: >-
            Either backups have stopped or a prune removed more than
            intended.

  - name: external
    rules:
      # These alerts catch failures outside the internal network. Every
      # other check in this file runs on the internal network, on the
      # server side of the tunnel, and all of them reported healthy for
      # the entire time nothing was reachable from outside.
      - alert: PublicEndpointDown
        # Scoped to the HTTP probes only. A `blackbox-.*` selector also
        # matches the DNS jobs, so a resolver fault would be reported as
        # an endpoint outage -- two alerts naming the wrong cause, which
        # is worse than one naming the right one.
        expr: probe_success{job=~"blackbox-(gated|open|home-gated|home-open)"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }} is unreachable from outside"
          description: >-
            The probe failed through Cloudflare. If several fire at once
            the tunnel is down, not the individual apps -- check
            cloudflared, and check DNS before assuming the apps broke.

      - alert: TunnelDown
        # Several public endpoints failing together is a tunnel or DNS
        # fault, not an app fault. Distinct alert so the notification
        # says the right thing at 3am.
        expr: >-
          count(probe_success{job=~"blackbox-(gated|open|home-gated|home-open)"} == 0)
          >= 3
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Multiple public endpoints down: tunnel or DNS, not the apps"
          description: >-
            {{ $value }} endpoints are failing at once. Cloudflare error
            1033 means cloudflared cannot reach the edge. Check whether
            AAAA resolution is working.

      - alert: DnsResolverAaaaFailing
        # Names the exact fault that took the stack down: A resolving
        # fine while AAAA SERVFAILs, which musl-based containers treat
        # as total lookup failure.
        expr: probe_success{job="blackbox-dns-aaaa"} == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "AAAA lookups failing on the {{ $labels.resolver }} resolver"
          description: >-
            A records may still resolve. musl-based containers
            (cloudflared, alpine images) fail the ENTIRE lookup when
            either half SERVFAILs, so this breaks things that look
            unrelated to DNS.

      - alert: DnsFilteringBypassed
        # DnsResolverDown catches "no answer". This catches the quieter
        # failure: an answer arrives, but not from Pi-hole. A known-blocked
        # domain resolving to a real address means the blocklists are not
        # being applied -- DNS Director's redirect removed, gravity empty,
        # or something upstream answering in Pi-hole's place. Nothing else
        # in this file would notice.
        expr: probe_success{job="blackbox-dns-blocked"} == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Pi-hole is answering but no longer blocking"
          description: >-
            A domain that should resolve to 0.0.0.0 returned a real
            address. Check DNS Director's global redirection is still set,
            that the Pi-hole MAC exemption is still present, and that
            gravity is populated (pihole -g).

      - alert: DnsResolverDown
        expr: probe_success{job="blackbox-dns"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "DNS resolver {{ $labels.resolver }} not answering"
          description: >-
            If this is Pi-hole, container DNS is about to break stack-wide.

      - alert: OriginTlsCertExpiringSoon
        expr: >-
          probe_ssl_earliest_cert_expiry{job="blackbox-origin"} - time()
          < 21 * 24 * 3600
        for: 1h
        labels:
          severity: critical
        annotations:
          summary: "Traefik's Let's Encrypt certificate expires in under 21 days"
          description: >-
            This is the ORIGIN certificate, not Cloudflare's. Traefik
            renews it over ACME DNS-01 around 30 days out, so this firing
            means renewal has failed -- check the cloudflare_dns_token
            secret and Traefik's log for acme errors. If it does expire,
            cloudflared's https origin fails TLS verification and every
            hostname goes down at once, which is why 21 days is earlier
            than the 14 used for the Cloudflare-facing probes.

      - alert: OriginTlsProbeDown
        expr: probe_success{job="blackbox-origin"} == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Cannot reach Traefik directly to check its certificate"
          description: >-
            The origin certificate is unmonitored while this fires.
            Expiry would not be noticed until it takes the site down.

      - alert: TlsCertExpiringSoon
        expr: >-
          probe_ssl_earliest_cert_expiry{job=~"blackbox-(gated|open|home-gated|home-open)"} - time()
          < 14 * 24 * 3600
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate for {{ $labels.instance }} expires in under 14 days"
          description: >-
            Cloudflare normally renews these automatically, so this
            firing means something is wrong with the tunnel hostname.

      - alert: HomeServiceDown
        expr: probe_success{job="home-services"} == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} is unavailable internally"
          description: >-
            The optional home service failed its direct health check.
            Check the mediastack-home Compose project and container logs.

  - name: updates
    rules:
      # Diun sets this to 1 per image when a newer digest exists
      # upstream. This is the replacement for Watchtower: you get told,
      # you read the release notes, you decide. Nothing updates itself.
      - alert: ImageUpdateAvailable
        expr: diun_image_update_available == 1
        for: 15m
        labels:
          severity: info
        annotations:
          summary: "Update available: {{ $labels.image }}"
          description: >-
            A newer image was published for {{ $labels.image }}
            (found by the {{ $labels.provider }} provider). Read the
            changelog, then bump it deliberately.

      - alert: DiunTrackingNothing
        # DiunStale only proves a run happened. This catches a run that
        # completed successfully while finding NOTHING, which is what
        # happens when Diun starts before Docker's embedded DNS has
        # registered docker-socket-proxy: the client fails to construct,
        # both providers report "No image found", the job reports success,
        # and update detection is silently dead until the next daily run.
        # Swarm has no ordering primitive to prevent the race, so detect
        # it instead.
        expr: count(diun_image_update_available) < 1
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Diun completed a run but is tracking no images"
          description: >-
            Update detection is silently doing nothing. Usually Diun lost
            its Docker client at startup; check its log for "Cannot create
            Docker client" and restart the service.

      - alert: DiunStale
        # Diun runs daily. If the last completed run is more than 26h
        # old it has wedged, and "no update notifications" would
        # otherwise be indistinguishable from "nothing has updated".
        expr: >-
          time() - diun_watch_last_run_timestamp_seconds > 93600
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Diun has not completed a run in over 26 hours"
          description: >-
            Update notifications are silently not happening.

      # -----------------------------------------------------------------
      # Indexers (scripts/prowlarr-indexer-metrics.py)
      # -----------------------------------------------------------------

      - alert: IndexerFailureRateHigh
        # Real Prowlarr traffic, not a synthetic probe. An indexer that fails
        # a fifth of its queries is degrading searches now, and the *arrs
        # report it as "nothing found" rather than as an error.
        expr: >-
          sum by (indexer,solver) (mediastack_prowlarr_queries{result="failure"})
          / sum by (indexer,solver) (mediastack_prowlarr_queries) > 0.20
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.indexer }} failing {{ $value | humanizePercentage }} of queries"
          description: >-
            Measured over 24h of real queries. If it sits behind a Cloudflare
            solver ({{ $labels.solver }}), check whether that solver is the
            cause before blaming the site: compare the two on the IDS
            dashboard, and try a mirror.

      - alert: ProwlarrMetricsWindowTruncated
        # The collector pages backwards until it reaches the window edge. If
        # it hits the page cap first the counts cover less than 24h, and every
        # rate derived from them is wrong in a way nothing else reveals.
        expr: mediastack_prowlarr_metrics_window_complete == 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Indexer metrics cover less than the full window"
          description: >-
            Paging hit PROWLARR_MAX_PAGES before reaching the cutoff, so the
            success rates are computed from a partial window. Raise the cap or
            shorten the window.

      # -----------------------------------------------------------------
      # Routers (scripts/router-exporter.py)
      # -----------------------------------------------------------------

      - alert: RouterUnreachable
        # A mesh node that stops answering is invisible otherwise: the wifi
        # keeps working from the other nodes, so nothing degrades in a way
        # anyone notices until coverage quietly gets worse in one room.
        expr: mediastack_router_up == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Router not answering: {{ $labels.router }}"
          description: >-
            {{ $labels.router }} ({{ $labels.role }}) has not responded over
            SSH for 10 minutes. Powered off, rebooting, or it lost the key.

      - alert: RouterTemperatureHigh
        # Broadcom radios run warm and the 70s are normal. This is set where
        # throttling and instability actually start.
        expr: mediastack_router_temperature_celsius > 95
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.router }} {{ $labels.sensor }} at {{ $value }}C"
          description: >-
            Sustained above 95C. Check airflow and whether it is sitting in
            sun or on top of something else warm.

      - alert: RouterMemoryLow
        # 512 MB and no swap. When these run out they drop connections rather
        # than slowing down, which looks like a wifi problem.
        expr: >-
          mediastack_router_memory_available_bytes
          / mediastack_router_memory_total_bytes < 0.10
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.router }} has under 10% memory free"
          description: >-
            These have no swap, so exhaustion shows up as dropped connections
            rather than slowness. A reboot clears it; repeated occurrences
            mean something is leaking.

      - alert: RouterBackhaulWeak
        # The wireless link carrying everything a node's clients do. Weak
        # backhaul caps that node no matter how strong its own radio looks to
        # the client.
        #
        # Measured from the NODE, not from the router's WDS interfaces. Those
        # only exist for some AiMesh attachment modes, so a node can be well
        # connected and have no WDS entry at all; alerting on those would have
        # watched one node three times and the other never.
        expr: mediastack_router_uplink_rssi_dbm < -80
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Weak mesh backhaul: {{ $labels.interface }} at {{ $value }} dBm"
          description: >-
            Below -80 dBm the link drops to a lower rate and every client on
            that node feels it. Usually means a node was moved, or something
            large now sits between it and the main router.

      - alert: RouterConntrackFilling
        expr: >-
          mediastack_router_conntrack_count
          / mediastack_router_conntrack_max > 0.80
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.router }} connection table over 80% full"
          description: >-
            New connections are refused once this fills, which presents as
            some sites loading and others not.

      - alert: RouterExporterStale
        expr: >-
          time() - mediastack_router_exporter_last_run_timestamp_seconds > 900
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Router metrics have not updated in 15 minutes"
          description: >-
            The collector runs every 2 minutes. Nothing is watching the
            routers while this is firing.

      # The ASUS httpd chain published 2026-10-23 (mrbruh.com/asusrouter,
      # CVE-2026-93489, -75779, -75775): a forged admin token, then a shell
      # command planted in ntp_server0, or an SSH key added. No fixed firmware
      # existed when this was written. These three watch for the traces.
      - alert: RouterNtpServerSuspicious
        expr: mediastack_router_ntp_server_valid == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Router {{ $labels.router }} has a non-hostname NTP server setting"
          description: >-
            ntp_server0 or ntp_server1 on {{ $labels.router }} holds
            characters a hostname never has. That is how the NTP command
            injection is delivered. Check `nvram get ntp_server0`, look for
            unknown SSH keys and telnetd, and treat the router as compromised
            until proven otherwise.

      - alert: RouterSshKeysChanged
        # changes() looks back 15m, so this stays up for a quarter of an hour
        # after the exporter sees a different key set. A key you added or
        # removed yourself fires it once; that is the intended price.
        expr: changes(mediastack_router_ssh_authorized_keys_digest[15m]) > 0
        labels:
          severity: critical
        annotations:
          summary: "SSH keys changed on router {{ $labels.router }}"
          description: >-
            The set of authorised SSH keys on {{ $labels.router }} is not what
            it was. If you did not add or remove one, check
            /jffs/.ssh/authorized_keys and `nvram get sshd_authkeys`.

      - alert: RouterTelnetRunning
        expr: mediastack_router_telnetd_running == 1
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "A telnet daemon is running on router {{ $labels.router }}"
          description: >-
            Nothing here uses telnet. A shell started that way is the
            demonstrated payload for the ASUS NTP injection.

      # -----------------------------------------------------------------
      # Authentik accounts (scripts/authentik-watchdog.py)
      # -----------------------------------------------------------------

      - alert: AuthentikNewAccount
        # Fires for 24h after an account first appears, then resolves on its
        # own. Accounts are gated upstream by the Google consent screen's
        # test-user allowlist, so this is "someone you allowlisted signed in
        # for the first time", not "a stranger got in". Informational by
        # design: it should be a thing you notice, not a thing that wakes you.
        expr: >-
          time() - mediastack_authentik_user_created_timestamp_seconds < 86400
        for: 5m
        labels:
          severity: info
        annotations:
          summary: "New Authentik account: {{ $labels.username }}"
          description: >-
            {{ $labels.username }} appeared in Authentik within the last day.
            If you did not expect it, deactivate it in Authentik and check
            the Google OAuth consent screen's test-user list, which is what
            gates who can reach the login at all.

      - alert: AuthentikWatchdogStale
        # Runs every 5 minutes. Past an hour it has wedged, and "no new
        # account alerts" would otherwise be indistinguishable from "nobody
        # is checking".
        expr: >-
          time() - mediastack_authentik_watchdog_last_run_timestamp_seconds > 3600
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Authentik account watch has not run in over an hour"
          description: >-
            New accounts would appear unannounced. Check
            mediastack-authentik-watchdog.timer.

      # -----------------------------------------------------------------
      # Media library consistency (scripts/media-watchdog.py)
      #
      # Every one of these describes a failure that has actually happened
      # here and produced no error anywhere: the container was up, the
      # mounts were fine, and the library was quietly wrong.
      # -----------------------------------------------------------------

      - alert: MediaWatchdogStale
        # Runs every 6h. Past 14h it has wedged, and "no media alerts"
        # would otherwise be indistinguishable from "nothing is wrong".
        expr: >-
          time() - mediastack_media_watchdog_last_run_timestamp_seconds > 50400
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Media watchdog has not run in over 14 hours"
          description: >-
            Library consistency checks are silently not happening. Check
            mediastack-media-watchdog.timer.

      - alert: MediaWatchdogFailed
        # The run itself broke, usually because the PinePods database was
        # unreachable, so the other metrics below are stale rather than
        # reassuring.
        expr: mediastack_media_watchdog_success == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Media watchdog could not complete its checks"
          description: >-
            The findings below are from an incomplete run and should not
            be trusted. Run scripts/media-watchdog.py by hand for the error.

      - alert: PodcastNotImported
        # A folder of episodes nobody can play. This is what a failed
        # import looks like from the outside: files on disk, no entry.
        expr: >-
          mediastack_media_podcast_imported == 0
          and mediastack_media_podcast_files_on_disk > 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Podcast folder is not in PinePods: {{ $labels.podcast }}"
          description: >-
            {{ $labels.podcast }} has audio files on disk but no PinePods
            entry, so none of it is playable. See "Importing a local
            podcast: two traps" in the README.

      - alert: PodcastImportedEmpty
        # The specific shape of the COMM/NUL failure: the podcast row is
        # created, then every episode insert fails, and the UI shows a
        # podcast with nothing in it rather than an error.
        expr: mediastack_media_podcast_episodes_in_db == 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Podcast has zero episodes: {{ $labels.podcast }}"
          description: >-
            The podcast exists in PinePods but holds no episodes. Usually
            an ID3 COMM frame failed the whole import; check
            mediastack_media_podcast_comm_frames for this folder.

      - alert: PodcastImportWillFail
        # Fires BEFORE anyone tries to import, which is the only useful
        # time to know. Existing episodes are unaffected.
        expr: mediastack_media_podcast_comm_frames > 0
        for: 6h
        labels:
          severity: info
        annotations:
          summary: "COMM frames will fail the next import: {{ $labels.podcast }}"
          description: >-
            {{ $value }} file(s) in {{ $labels.podcast }} carry an ID3 COMM
            frame. Already-imported episodes are fine, but the next import
            of this folder will insert nothing. Strip them with
            scripts/podcast-comm-strip.py.

      - alert: PodcastEpisodesMissingDuration
        # .m4a/.m4b import with no duration at all. Playback works, but
        # progress bars and "time remaining" are wrong everywhere.
        expr: mediastack_media_podcast_zero_duration_episodes > 0
        for: 6h
        labels:
          severity: info
        annotations:
          summary: "Episodes with no duration: {{ $labels.podcast }}"
          description: >-
            {{ $value }} episode(s) in {{ $labels.podcast }} have a duration
            of zero. PinePods does not read duration from MP4-container
            files, and a feed can list an episode without a length (and
            downloading it does not fill one in). Either way, fix from
            ffprobe on the file or the enclosure URL.

      - alert: PodcastOrphanEpisodes
        # Rows pointing at files that are gone. Clicking one is an error
        # with no explanation.
        expr: mediastack_media_podcast_orphan_episodes > 0
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Episodes point at missing files: {{ $labels.podcast }}"
          description: >-
            {{ $value }} episode(s) in {{ $labels.podcast }} reference a file
            that no longer exists. Deleting media without removing the row
            leaves these behind.

      - alert: PodcastTitleDrift
        # Retagging files does nothing to rows already imported, so this
        # stays wrong indefinitely and looks like the retag failed.
        expr: mediastack_media_podcast_title_drift_episodes > 0
        for: 6h
        labels:
          severity: info
        annotations:
          summary: "Stored titles no longer match file tags: {{ $labels.podcast }}"
          description: >-
            {{ $value }} episode(s) in {{ $labels.podcast }} differ from their
            file's tag. An import only inserts new episodes and will never
            correct these; the rows have to be updated directly.

      - alert: MediaRootOwnedFiles
        # Detects containers accidentally writing media as root.
        expr: mediastack_media_root_owned_files > 0
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Root-owned files under {{ $labels.tree }}"
          description: >-
            {{ $value }} root-owned path(s) under {{ $labels.tree }}. Some app
            is running as uid 0 and writing into a media tree; find it
            before the count grows.

  - name: worker-node-maintenance
    rules:
      # These come from nuc-nodes/common/mediastack-node-*.sh via each
      # worker's node-exporter textfile collector. The jobs are systemd
      # timers on machines nobody logs into, so "stopped running" has to be
      # an explicit staleness check or it looks exactly like "all fine".
      - alert: SystemdUnitFailed
        # mediastack-recovery.service sat failed for 35 minutes after a
        # reboot with nothing to say so. node-exporter's systemd collector
        # is scoped to this stack's units, docker and mounts.
        expr: node_systemd_unit_state{state="failed"} == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.name }} has failed on {{ $labels.instance }}"
          description: >-
            `systemctl status {{ $labels.name }}` and `journalctl -u
            {{ $labels.name }}` on the node.

      - alert: NodeUpdateStale
        # Weekly. 10 days allows one missed run plus slack.
        expr: time() - mediastack_node_update_last_run_timestamp_seconds > 864000
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} has not run its weekly update in over 10 days"
          description: >-
            The unattended update timer is not firing on this node. Check
            `systemctl status mediastack-node-update.timer` there.

      - alert: NodeUpdateFailed
        expr: mediastack_node_update_success == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Unattended update failed on {{ $labels.instance }}"
          description: >-
            `journalctl -u mediastack-node-update` on the node. A
            pre-update btrfs snapshot is in /.snapshots.

      - alert: NodeRebootOverdue
        # The update books a reboot for 03:30 the same night. Still
        # pending a day later means the reboot never happened.
        expr: mediastack_node_update_reboot_pending == 1
        for: 24h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} is still waiting on a reboot a day after its update"
          description: >-
            The kernel or another reboot-bound package was upgraded and the
            booked reboot did not happen. The node is running old code.

      - alert: NodeDidNotRejoinAfterReboot
        expr: mediastack_node_postboot_healthy == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }} rebooted but did not fully recover"
          description: >-
            The post-boot check gave up after 15 minutes: NFS, swarm
            membership or a standalone container is not back. A lost swarm
            membership needs a fresh join token from the manager.

      - alert: NodeBackupStale
        expr: time() - mediastack_node_backup_last_run_timestamp_seconds > 172800
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} node-local backup is over 2 days old"
          description: >-
            The nightly copy of this node's local state to the manager is
            not completing. See `journalctl -u mediastack-node-backup`.

      - alert: NodeBackupFailed
        expr: mediastack_node_backup_success == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Node-local backup failed on {{ $labels.instance }}"

      - alert: NodeBtrfsDeviceErrors
        # The node's two disks are a RAID1 mirror. These counters climb when
        # one disk starts failing reads/writes or returning corrupt data,
        # usually well before it dies outright.
        expr: mediastack_node_btrfs_device_errors_total > 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }}: btrfs {{ $labels.type }} on {{ $labels.device }}"
          description: >-
            `btrfs device stats /` on the node. A non-zero counter means
            that disk has misbehaved. The mirror still holds a good copy;
            run a scrub and check SMART before it gets worse.

      - alert: NodeBtrfsNotRaid1
        expr: mediastack_node_btrfs_raid1 == 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }}: btrfs is no longer all RAID1"
          description: >-
            Data, metadata or system fell back to a profile with no second
            copy (a disk dropped out, or a balance was interrupted). Some
            data may exist on one disk only. `btrfs filesystem usage /`.

      - alert: NodeBtrfsScrubErrors
        expr: mediastack_node_btrfs_scrub_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }}: btrfs scrub found unrecoverable errors"
          description: >-
            The monthly scrub found blocks it could not repair from the
            other copy. `btrfs scrub status -R /` and `dmesg`.

      - alert: NodeBtrfsScrubStale
        # Monthly. 40 days allows one missed run plus slack.
        expr: time() - mediastack_node_btrfs_scrub_last_run_timestamp_seconds > 3456000
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} has not scrubbed its mirror in over 40 days"
          description: >-
            Check `systemctl status mediastack-node-btrfs-scrub.timer`.

      - alert: NodeBtrfsStatsStale
        # Hourly. If these stop, the error alerts above go blind.
        expr: time() - mediastack_node_btrfs_stats_last_run_timestamp_seconds > 14400
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} stopped reporting btrfs health"
          description: >-
            The hourly check is not running, so disk-error alerts for this
            node cannot fire. Check `mediastack-node-btrfs-stats.timer`.

      - alert: NodePacmanCacheLarge
        # The weekly update trims this to two versions per package. Well
        # past that means the trim is not running or not working.
        expr: mediastack_node_pacman_cache_bytes > 6e9
        for: 1d
        labels:
          severity: info
        annotations:
          summary: "{{ $labels.instance }} pacman cache is {{ $value | humanize1024 }}B"
          description: >-
            The weekly update keeps two versions per package. Check the
            last `journalctl -u mediastack-node-update` for the paccache
            lines.

      - alert: NodeNvmeSmartFailed
        expr: mediastack_node_nvme_smart_passed == 0 or mediastack_node_nvme_critical_warning != 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.instance }}: {{ $labels.model }} ({{ $labels.device }}) reports a SMART failure"
          description: >-
            The drive's own self-assessment failed or it raised a critical
            warning (low spare, over temperature, reliability degraded or
            read-only). The RAID1 mirror still has the other disk: replace
            this one before the second ever has a problem.

      - alert: NodeNvmeWearHigh
        expr: mediastack_node_nvme_percentage_used > 80
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.model }} ({{ $labels.device }}) on {{ $labels.instance }} has used {{ $value }}% of its rated endurance"
          description: >-
            Not a failure yet, but plan a replacement. Worth checking what
            is writing heavily to this node.

      - alert: NodeNvmeSpareLow
        expr: mediastack_node_nvme_available_spare_percent <= mediastack_node_nvme_available_spare_threshold_percent + 10
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.model }} ({{ $labels.device }}) on {{ $labels.instance }} is running out of spare capacity"
          description: >-
            Spare blocks replace worn-out ones. Near the drive's own
            threshold means it is wearing out faster than it can hide.

      - alert: NodeNvmeMediaErrors
        # media_errors only ever counts up; a rise, not the absolute value,
        # is the signal. Old drives can carry a stable non-zero count.
        expr: increase(mediastack_node_nvme_media_errors_total[1d]) > 0
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.model }} ({{ $labels.device }}) on {{ $labels.instance }} logged new media errors"
          description: >-
            Unrecoverable data errors on the drive itself. Run a btrfs
            scrub and watch `btrfs device stats /`.

      - alert: NodeNvmeHot
        expr: mediastack_node_nvme_temperature_celsius > 75
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.model }} ({{ $labels.device }}) on {{ $labels.instance }} is at {{ $value }}C"
          description: >-
            Sustained high drive temperature. Check the node's airflow and
            whether a long scrub or transcode is running.

      - alert: NodeNvmeHealthStale
        # Daily. Needs smartmontools, which arrives with the first full
        # upgrade after this was added, so it only fires after a metric
        # has existed and then stopped.
        expr: time() - mediastack_node_nvme_last_run_timestamp_seconds > 172800
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.instance }} stopped reporting NVMe health"
          description: >-
            `systemctl status mediastack-node-smart.timer` on the node.

      - alert: NodeBackupInvalid
        # From scripts/check-node-backups-are-real.sh on the manager: the
        # tar is stale, will not open, or has shrunk to under half its
        # last good size. The node-side job can report success while this
        # is true, which is the whole point of checking from this end.
        expr: mediastack_node_backup_check_ok == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "The {{ $labels.node }} backup on the manager is not a usable backup"
          description: >-
            Stale, unreadable or hollow. Run
            scripts/check-node-backups-are-real.sh to see which, then check
            `journalctl -u mediastack-node-backup` on the node.

      - alert: NodeBackupCheckStale
        expr: time() - mediastack_node_backup_check_last_run_timestamp_seconds > 172800
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "The node backup check has not run in over 2 days"
          description: >-
            Nothing is verifying the worker backups. Check
            `systemctl status mediastack-check-node-backups.timer` on the
            manager.

      - alert: NodePacnewPending
        # Config files an upgrade could not merge for you. Not urgent, but
        # unmerged defaults accumulate, and one of them (an SSH or
        # bootloader setting) eventually matters.
        expr: mediastack_node_pacnew_files > 0
        for: 7d
        labels:
          severity: info
        annotations:
          summary: "{{ $labels.instance }} has {{ $value }} unmerged .pacnew/.pacsave file(s)"
          description: >-
            Listed in `journalctl -u mediastack-node-update`. Review with
            `sudo pacdiff` (from pacman-contrib), keeping your own edits
            where they matter. The update never merges these itself.
