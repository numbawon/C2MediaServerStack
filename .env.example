# Copy to .env and fill in. .env is git-ignored -- real values never get
# committed. This file holds non-sensitive config only; actual passwords/
# tokens live in Swarm secrets or ./secrets/*.txt (see scripts/init-secrets.sh
# and README.md), not here.

# Matches your user on this host (id -u / id -g)
COMMON_PUID=1000
COMMON_PGID=1000

COMMON_TZ=America/New_York

# Public domain, routed through the Cloudflare Tunnel
COMMON_DOMAIN=example.com

# Contact address on the Let's Encrypt account. Used only for expiry
# warnings if renewal ever stops working -- there is no verification step
# and it is never published in the certificate.
ACME_EMAIL=you@example.com

# Existing media library root (see README for the expected subfolder layout)
COMMON_MEDIA=/mnt/Media

# Active + completed download folders used by qBittorrent and picked up by
# the *arr apps. Keep these on the SAME filesystem as COMMON_MEDIA -- the
# *arr apps hardlink on import, and a cross-filesystem move silently
# becomes a full copy instead.
COMMON_DOWNLOADS=/mnt/Media/Downloads
COMMON_COMPLETED=/mnt/Media/Completed

# Container-owned data stores that are NOT media libraries (Immich's
# managed store, for one). Dot-prefixed so it stays out of `ls` on the
# library root and out of the Plex and *arr scanners.
COMMON_APPDATA=/mnt/Media/.appdata

# App configuration and runtime state, moved out of Docker named volumes so
# it is editable on the host without docker exec.
#
# Deliberately inside the repo directory rather than under COMMON_APPDATA.
# /mnt/Media is served read-write by the `files` service, and these hold API
# keys and admin settings: an *arr's config.xml, Pi-hole's admin config. A
# config an app trusts must not be reachable from a file browser. The repo
# directory is served by nothing, so this is reachable over SSH and nothing
# else. Gitignored, and covered by both backup scripts.
#
# Must be an ABSOLUTE path: Swarm does not resolve bind paths relative to the
# compose file.
COMMON_CONFIG=/home/youruser/C2MediaServerStack/.appdata

# Your LAN's subnet, and this host's address on it. The VPN container needs
# the subnet in its outbound allowlist (so LAN and Docker traffic bypasses
# the tunnel and replies route correctly), and binds its HTTP proxy to the
# IP so the proxy is reachable from your LAN but never on all interfaces.
COMMON_LAN_SUBNET=192.168.1.0/24
COMMON_LAN_IP=192.168.1.10

# NordVPN exit country for the VPN container (gluetun SERVER_COUNTRIES)
COMMON_VPN_COUNTRY="United States"

# Specific NordVPN servers to pin the exit to (gluetun SERVER_HOSTNAMES),
# comma-separated. Leave empty to let gluetun pick any server in
# COMMON_VPN_COUNTRY, which draws a new exit IP on every container start.
#
# Pinning matters because Cloudflare binds cf_clearance to the IP that
# solved the challenge. ByParr solves through this tunnel, so a new exit IP
# invalidates every cached clearance and the next few searches fail until it
# re-solves. It recovers on its own; pinning just stops the churn.
#
# Use SEVERAL hostnames, not one. gluetun picks among them, so a single
# entry means a dead server takes the whole tunnel down with it, and the
# kill switch then stops everything behind it. Same city keeps latency
# consistent. List the candidates from gluetun's own server data:
#   docker cp vpn-client:/gluetun/servers/nordvpn.json /tmp/n.json
#   python3 -c "import json;d=json.load(open('/tmp/n.json'));\
#     print('\\n'.join(s['hostname'] for s in d['servers'] \
#     if s.get('vpn')=='wireguard' and s.get('city')=='YourCity'))"
#
# Leave these as-is only as a format example. Pick your OWN servers: this
# file is public, and naming the specific servers you exit through ties a
# small, known IP pool to whoever is reading the repo.
COMMON_VPN_SERVERS="usXXXXX.nordvpn.com,usYYYYY.nordvpn.com,usZZZZZ.nordvpn.com"

# --- Stage 3 services ---------------------------------------------------

# Local config-volume snapshots. Put these on a different physical device
# from the one holding the Docker named volumes being snapshotted --
# backing a disk up to itself survives a fat-finger delete but not a drive
# failure. The real disaster copy is restic -> B2 in backup-offsite.sh;
# this one exists for fast restores.
COMMON_BACKUP_LOCAL=/mnt/Storage/.backups/local

# The router. Pi-hole forwards here rather than to a public resolver: the
# router does DNS-over-TLS upstream, and it intercepts outbound port 53
# anyway (Merlin's DNS Director), so naming it explicitly makes the real
# path visible instead of relying on that interception by accident.
COMMON_LAN_ROUTER=192.168.1.1

# --- Open WebUI (docker-compose.ai.yml) ---------------------------------

# Signs session cookies. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# If absent, Open WebUI makes a new one each start and logs everyone out.
OPENWEBUI_SECRET_KEY=

# From the Authentik OAuth2/OpenID provider you create for Open WebUI.
# The application slug must be `open-webui` to match OPENID_PROVIDER_URL
# in docker-compose.ai.yml. Redirect URI: https://ai.<domain>/oauth/oidc/callback
OPENWEBUI_CLIENT_ID=
OPENWEBUI_CLIENT_SECRET=

# Interface Suricata listens on. Must be the real NIC carrying LAN traffic;
# a docker bridge would only show container-to-container packets.
IDS_INTERFACE=eno1

# PinePods (podcast manager). DB password is internal to the stack; the
# admin values seed the first account on initial boot only.
PINEPODS_DB_PASSWORD=
PINEPODS_ADMIN_USER=
PINEPODS_ADMIN_PASSWORD=
PINEPODS_ADMIN_FULLNAME=
PINEPODS_ADMIN_EMAIL=
