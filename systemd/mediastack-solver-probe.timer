[Unit]
Description=Compare Cloudflare solvers every 30 minutes

[Timer]
# Every 4 hours, down from 30 minutes. This is a canary, not the primary
# signal: scripts/prowlarr-indexer-metrics.py measures real traffic and is
# what the success rates should be read from.
#
# The frequency was cut because the probe itself was a liability. Ten
# browser sessions every 30 minutes is ~96 requests per day per target from
# one address, against five URLs of a single site, which is precisely the
# pattern that gets an IP blocked. A probe that provokes the failure it
# measures is worse than no probe. Six runs a day is enough to notice a
# solver going down without contributing to the problem.
OnBootSec=10min
OnUnitActiveSec=4h

[Install]
WantedBy=timers.target
