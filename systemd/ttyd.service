[Unit]
Description=ttyd web terminal (docker_gwbridge only, reached via Traefik)
After=network.target docker.service

[Service]
# --interface 172.20.0.1: the docker_gwbridge gateway IP, not loopback.
# Binding to 127.0.0.1 looks more locked-down but is actually unreachable
# from Traefik's own container -- a socket bound to loopback only accepts
# connections whose destination is literally 127.0.0.1, and Traefik dialing
# in from its own network namespace can never satisfy that. Binding to this
# specific docker-internal IP instead keeps the same real-world property
# (nothing on the LAN/WAN can reach it -- only traffic from inside Docker's
# bridge can) while actually being reachable by Traefik. Same reasoning as
# the docker_gwbridge subnet in docker-compose.download.yml's
# FIREWALL_OUTBOUND_SUBNETS -- stable for a single-node host, revisit if
# this host ever changes its Docker network layout.
#
# `login` (not bash/sh) means every session is a real PAM login -- username
# and password required even though Authentik already gated the request
# upstream. Two independent locks, not one.
#
# -W/--writable: ttyd is read-only by default (output only, keystrokes
# silently dropped) -- without this every session would just watch the
# login prompt time itself out after 60s, unable to type anything.
#
# No custom -t fontFamily=... -- a previous version pinned
# 'CaskaydiaCove Nerd Font'. On a client without that font installed,
# xterm.js's cell-metrics measurement degenerated to a 0-size grid: the
# terminal still accepted keystrokes (raw WS input keeps flowing) but
# rendered nothing at all, i.e. a blank screen. Confirmed by removing the
# flag and reproducing a working prompt. Leave this on the browser default
# monospace font unless a font that's guaranteed present on every client
# device gets pinned instead.
ExecStart=/usr/bin/ttyd --writable --interface 172.20.0.1 --port 7681 login
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
