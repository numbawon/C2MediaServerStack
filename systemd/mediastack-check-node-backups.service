# Checks that the worker nodes' backup tars on the manager are real.
# See scripts/check-node-backups-are-real.sh.
#
# Replace youruser with your actual repo path before installing.
#
# Install:
#   sudo cp systemd/mediastack-check-node-backups.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mediastack-check-node-backups.timer
[Unit]
Description=mediastack node backup check (fresh, readable, not hollow)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/youruser/C2MediaServerStack
ExecStart=/home/youruser/C2MediaServerStack/scripts/check-node-backups-are-real.sh
