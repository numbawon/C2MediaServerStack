[Unit]
Description=Run mediastack backup verification weekly

[Timer]
# Sunday 07:00, deliberately after the 04:30 off-site backup has finished so
# it verifies the newest snapshot rather than racing it. That run now takes
# about an hour (backup, then forget + prune + repack), so the old 05:00
# slot landed inside it: on 2026-09-27 restic's exclusive lock was still
# held by the off-site job and the weekly check failed with "repository is
# already locked".
OnCalendar=Sun *-*-* 07:00:00
Persistent=true
# The 5% subset restic reads is chosen at random per run, so spreading
# start times means different packs get sampled over the weeks rather
# than the same slice every Sunday at exactly 07:00.
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
