name: mediastack/trusted
description: "Never ban infrastructure or the local networks"
# A false positive that bans one of these takes the stack off the internet
# rather than stopping an attacker, so they are excluded before any
# scenario gets to vote.
whitelist:
  reason: "local networks and container infrastructure"
  cidr:
    - 127.0.0.0/8
    - ${COMMON_EDGE_SUBNET}
    - ${COMMON_INTERNAL_SUBNET}
    - ${COMMON_DOCKER_GWBRIDGE_SUBNET}
    - ${COMMON_LAN_SUBNET}
